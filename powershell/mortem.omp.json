{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#0CA0D8",
    "blue_frappe": "#89B4FA",
    "dark_blue": "#007ACC",
    "green": "#45F1C2",
    "lavender": "#B4BEFE",
    "magenta": "#BC93FF",
    "orange": "#CD5E42",
    "pink": "#F5C2E7",
    "red": "#CD4277",
    "turquoise": "#14A5AE"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "01/02 03:04PM"
          },
          "template": "[{{ .CurrentDate | date .Format }}]",
          "foreground": "p:green",
          "type": "time",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": "/",
            "style": "full"
          },
          "template": " \ueaf7 {{ path .Path .Location }} ",
          "foreground": "p:blue",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "template": "{{ if or (.Working.Changed) (.Staging.Changed) (gt .StashCount 0) }}<p:magenta>{{ .UpstreamIcon }} {{ .HEAD }}</>{{ else }}<p:green>{{ .UpstreamIcon }} {{ .HEAD }}</>{{ end }}{{ if (gt .Ahead 0)}}<p:turquoise> {{ .BranchStatus }}</>{{ end }}{{ if (gt .Behind 0)}}<p:turquoise> {{ .BranchStatus }}</>{{ end }}{{ if (gt .StashCount 0)}}<p:pink> *{{ .StashCount }}</>{{ end }}{{ if .Staging.Changed }} <p:green>{{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }} <p:red>{{ .Working.String }}</>{{ end }}",
          "type": "git",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\ue3bf ",
          "foreground": "p:orange",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "❯",
          "foreground": "p:dark_blue",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
